@model IEnumerable<SistemaCursosIA.Models.Estudiante>
@{ ViewData["Title"] = "Estudiantes"; }

<div class="pagehead"><h1>Estudiantes</h1><a class="button primary" asp-action="Create">Nuevo registro</a></div>
@if (TempData["Error"] != null) { <div class="notice">@TempData["Error"]</div> }
<div class="panel"><table class="table"><thead><tr><th>Nombre</th><th>Apellido</th><th>Correo</th><th>Telefono</th><th>Acciones</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
  <tr><td>@item.Nombre</td><td>@item.Apellido</td><td>@item.Correo</td><td>@item.Telefono</td><td class="actions">
  <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
  <a asp-action="Details" asp-route-id="@item.Id">Ver</a>
  <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
  </td></tr>
}
</tbody></table>
@if (!Model.Any()) { <p>Todavía no hay registros. Puedes agregar uno desde el botón superior.</p> }
</div>
