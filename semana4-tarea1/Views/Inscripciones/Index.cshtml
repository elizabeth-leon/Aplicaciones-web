@model IEnumerable<SistemaCursosIA.Models.Inscripcion>
@{ ViewData["Title"] = "Inscripciones"; }

<div class="pagehead"><h1>Inscripciones</h1><a class="button primary" asp-action="Create">Nuevo registro</a></div>
@if (TempData["Error"] != null) { <div class="notice">@TempData["Error"]</div> }
<div class="panel"><table class="table"><thead><tr><th>Estudiante</th><th>Curso</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
  <tr><td>@(item.Estudiante?.Nombre ?? "—")</td><td>@(item.Curso?.Nombre ?? "—")</td><td>@item.FechaInscripcion.ToString("dd/MM/yyyy")</td><td>@item.Estado</td><td class="actions">
  <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
  <a asp-action="Details" asp-route-id="@item.Id">Ver</a>
  <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
  </td></tr>
}
</tbody></table>
@if (!Model.Any()) { <p>Todavía no hay registros. Puedes agregar uno desde el botón superior.</p> }
</div>
